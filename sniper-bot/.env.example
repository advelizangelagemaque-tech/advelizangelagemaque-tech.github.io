# ==== Exchange ====
# binance (nativo, com WebSocket) ou outra CEX da ccxt: bybit, okx, ...
EXCHANGE=binance

# ==== Chaves de API ====
# TESTNET Binance: gere em https://testnet.binancefuture.com
# (para bybit/okx, gere as chaves de testnet/demo no painel da respectiva exchange)
# Nunca habilite saque. Restrinja por IP no painel da exchange.
BINANCE_API_KEY=coloque_sua_key_aqui
BINANCE_API_SECRET=coloque_seu_secret_aqui

# true = testnet de futuros (SEMPRE comece com true)
USE_TESTNET=true

# ==== Parâmetros de trade ====
# Margem (USDT) usada por entrada. Comece pequeno.
MARGIN_USDT=20

# Alavancagem. CUIDADO: amplifica perdas tanto quanto ganhos.
LEVERAGE=3

# Alvo de lucro e perda máxima, em fração do preço de entrada.
# 0.10 = 10% no preço (com leverage o PnL é maior).
TAKE_PROFIT_PCT=0.10
STOP_LOSS_PCT=0.05

# Só snipa pares cotados nesta moeda (perpétuos USDT).
QUOTE_ASSET=USDT

# Frequência de checagem por novas listagens (milissegundos).
POLL_INTERVAL_MS=500

# Segurança extra: encerra o bot após N entradas (0 = sem limite).
MAX_TRADES=1

# ==== Filtro de qualidade da listagem (0 = desligado) ====
# Spread máximo aceitável no topo do livro (0.03 = 3%).
MAX_SPREAD_PCT=0.03
# Profundidade mínima somada no livro (bids+asks), em USDT.
MIN_BOOK_DEPTH_USDT=1000
# Volume mínimo 24h em USDT (numa listagem nova costuma ser baixo; deixe 0).
MIN_QUOTE_VOLUME=0

# ==== Trailing stop ====
# true = usa trailing stop (protege o lucro deixando o preço correr).
USE_TRAILING=false
# Recuo a partir do pico que dispara a saída (0.01 = 1%). Binance: 0.1%..5%.
TRAILING_CALLBACK_PCT=0.01

# ==== Cooldown ====
# Segundos de espera entre uma entrada e a próxima (0 = sem cooldown).
COOLDOWN_SECONDS=0

# ==== Alertas Telegram (opcional; vazio = desligado) ====
# @BotFather -> /newbot para o token; chat_id via /getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
