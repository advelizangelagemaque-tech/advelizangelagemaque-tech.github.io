[Unit]
Description=Radar de pump fresco (acha pumps cedo -> watchlist -> alerta Telegram)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/advelizangelagemaque-tech.github.io/sniper-bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ec2-user/advelizangelagemaque-tech.github.io/sniper-bot/venv/bin/python -m bybit_bot.pump_radar --watch 900 --telegram
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
